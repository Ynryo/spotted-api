#!/usr/bin/env sh

echo "🔍 [pre-commit] Vérification rapide de la syntaxe..."

# 1. Vérification de la syntaxe PHP sur les fichiers modifiés (staged)
STAGED_PHP_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.php$')

if [ -n "$STAGED_PHP_FILES" ]; then
    for file in $STAGED_PHP_FILES; do
        if [ -f "$file" ]; then
            php -l "$file" > /dev/null 2>&1
            if [ $? -ne 0 ]; then
                echo "❌ Erreur de syntaxe PHP détectée dans : $file"
                php -l "$file"
                exit 1
            fi
        fi
    done
    echo "✅ Syntaxe PHP valide sur les fichiers indexés."
fi

# 2. Vérification des fichiers YAML de configuration
if [ -f "bin/console" ]; then
    php bin/console lint:yaml config --parse-tags > /dev/null 2>&1
    if [ $? -ne 0 ]; then
        echo "❌ Erreur de syntaxe YAML dans config/"
        php bin/console lint:yaml config --parse-tags
        exit 1
    fi
    echo "✅ Fichiers YAML valides."
fi

echo "🚀 [pre-commit] Contrôles rapides validés !"
exit 0
